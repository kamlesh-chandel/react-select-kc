
{
  "compilerOptions": {
    "types": ["node"],

    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    "declaration": true,
    "declarationDir": "types",
    "emitDeclarationOnly": false,

    "jsx": "react-jsx",
    "strict": true,

    "noEmit": true
  },
  "include": ["src"]
}
